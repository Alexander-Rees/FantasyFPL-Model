# Database Configuration for Article Scraper
# Copy this file to .env and fill in your database credentials

# PostgreSQL Connection (use same as backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fpl_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# For Supabase (if using):
# DB_HOST=db.your-project.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_password
