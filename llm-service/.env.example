# LLM Service Environment Configuration
# Copy this to .env and configure

# Service
SERVICE_NAME=fpl-llm-service
PORT=5002

# Models (will download automatically on first run)
LLM_MODEL_NAME=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# LLM Generation
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9

# RAG
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

# Security (match with backend)
INTERNAL_API_TOKEN=dev-internal-token

# Paths
VECTOR_DB_PATH=data/vector_db
SCRAPED_DATA_PATH=scraper/data/raw/scraped
