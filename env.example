# Supabase Database Configuration
# Copy this file to .env and fill in your actual values
# ⚠️ DO NOT COMMIT .env - It contains sensitive credentials

# Supabase PostgreSQL Connection (for direct database access)
# Get these from: Supabase Dashboard → Settings → Database → Connection string
# NOTE: For direct PostgreSQL connections (Spring Boot & Python), you need the DATABASE PASSWORD, not the API key
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=postgres

# Supabase API Keys (for Supabase JS client - optional, not used by backend/Python)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Spring Boot Configuration (optional - can use DB_* vars above)
# NOTE: If using password in JDBC URL, special characters need URL encoding:
# + → %2B, @ → %40, ! → %21
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Flask API Configuration
INTERNAL_API_TOKEN=dev-internal-token

# Redis Configuration (optional - for local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

